# Dola Studio first-run template. Placeholders only; not production credentials.
# Copy to .env.local, replace the API key and proxy, and prepare browser/system dependencies.
# These are conservative setup choices; config.py may have different defaults.

# DOLA_PORT affects the default URL only. Set Uvicorn --port to match.
DOLA_PORT=8002
DOLA_PUBLIC_BASE=http://127.0.0.1:8002
DOLA_API_KEYS=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_KEY

# Paths resolve from the service working directory (normally the repository root).
DOLA_DB_PATH=tasks.db
DOLA_POOL_DB_PATH=pool_usage.db
DOLA_DOWNLOAD_DIR=downloads
DOLA_REFERENCE_FILE_DIR=refs
DOLA_THUMB_DIR=thumbs

# Replace this with a proxy reachable from the server.
DOLA_PROXY=http://127.0.0.1:7890

# Requires installed browser runtimes/binaries. Headful mode needs DISPLAY or Xvfb.
DOLA_COOKIE_RUNTIME=cloak
DOLA_CLOAK_HEADLESS=0

# Start small. Console-saved settings can override some environment defaults.
DOLA_MAX_CONCURRENCY=1
DOLA_MAX_PENDING_TASKS=100
DOLA_WORK_15S_CONCURRENCY=1
DOLA_LOGIN_CONCURRENCY=1

# Delivery, cleanup and recovery.
DOLA_VIDEO_DELIVERY=download
DOLA_RECOVER_TIMEOUT_SECONDS=10800
DOLA_TASK_RETENTION_DAYS=14
DOLA_DOWNLOAD_MAX_BYTES=21474836480

# Choose an accurate material origin and disable automatic paid confirmation for setup.
DOLA_DEFAULT_REFERENCE_SOURCE=unspecified
DOUBAO_ALLOW_PAID=0

# No automatic release source is configured by this template.
DOLA_UPDATE_REPO=
